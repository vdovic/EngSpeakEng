# ── SpeakEnglish — environment variables ─────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for AI word enrichment (POST /api/enrich)
# Get your key at: https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL for Google Drive sync (Settings → Google Drive Sync)
#
# Google Cloud Console setup (one-time, ~5 minutes):
#   1. Create a Google Cloud project
#   2. Enable the Google Drive API
#   3. Create OAuth 2.0 credentials → Web Application
#   4. Add your app URL (e.g. http://localhost:5173) to both:
#        Authorised JavaScript origins
#        Authorised redirect URIs
#      For production also add your Vercel domain (https://yourapp.vercel.app)
#   5. Copy both the Client ID and the Client Secret from the credentials page
#
# VITE_GOOGLE_CLIENT_ID  — public, safe to commit to the repo
# GOOGLE_CLIENT_SECRET   — NEVER prefix with VITE_; never commit; server-only
#                          In Vercel: Settings → Environment Variables
#                          (Token exchange/refresh is proxied through /api/google-token
#                           and /api/google-refresh so this secret never reaches the browser)
# ─────────────────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
