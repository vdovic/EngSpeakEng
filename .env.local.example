# ── SpeakEnglish — environment variables ─────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for AI word enrichment (POST /api/enrich)
# Get your key at: https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL for Google Drive auto-sync (Settings → Google Drive Sync)
#
# Google Cloud Console setup (one-time, ~5 minutes):
#   1. Create a Google Cloud project
#   2. Enable the Google Drive API
#   3. Configure OAuth consent screen → add yourself as a test user
#   4. Create OAuth 2.0 credentials → Web Application
#   5. Add your app URL(s) to both:
#        Authorised JavaScript origins
#        Authorised redirect URIs
#        (e.g. http://localhost:5173  and  https://yourapp.vercel.app)
#   6. Copy Client ID and Client Secret from the credentials page
#
# VITE_GOOGLE_CLIENT_ID  — public, safe to commit
# GOOGLE_CLIENT_SECRET   — server-only, NEVER use VITE_ prefix, never commit
#                          Add to Vercel: Settings → Environment Variables
#                          Token exchange/refresh proxied through /api/google-token
#                          and /api/google-refresh so secret never reaches browser
# ─────────────────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
